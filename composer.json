{
    "name": "aria-php/aria-graphql-client",
    "description": "ARIA GraphQL library",
    "version": "1.2.1",
    "type": "library",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Marcus Povey",
            "email": "marcus@instruct-eric.eu"
        },
        {
            "name": "Fiona Sanderson",
            "email": "fiona@instruct-eric.eu"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^8.1",
        "squizlabs/php_codesniffer": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "ARIA\\GraphQLClient\\": "classes/"
        }
    },
    "minimum-stability": "dev",
    "require": {
        "guzzlehttp/guzzle": "^7.0"
    },
    "suggest": {
        "symfony/cache": "For cached queries"
    }
}

